{
  "name": "git-baseline-marker",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "assets/logo.png",
  "version": "0.4.0",
  "publisher": "Storehouseconsciousness",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gitBaselineHighlights.selectBaseline",
        "title": "%command.selectBaseline%"
      },
      {
        "command": "gitBaselineHighlights.selectProjection",
        "title": "%command.selectProjection%"
      },
      {
        "command": "gitBaselineHighlights.toggle",
        "title": "%command.toggle%"
      },
      {
        "command": "gitBaselineHighlights.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "gitBaselineHighlights.showLegend",
        "title": "%command.showLegend%"
      },
      {
        "command": "gitBaselineHighlights.selectBaselineForAll",
        "title": "%command.selectBaselineForAll%"
      },
      {
        "command": "gitBaselineHighlights.selectBaselineForRepository",
        "title": "%command.selectBaselineForRepository%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitBaselineHighlights",
          "title": "%view.container%",
          "icon": "assets/view.svg"
        }
      ]
    },
    "views": {
      "gitBaselineHighlights": [
        {
          "id": "gitBaselineHighlights.repositories",
          "name": "%view.repositories%",
          "contextualTitle": "%view.repositories%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitBaselineHighlights.selectBaselineForAll",
          "when": "view == gitBaselineHighlights.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitBaselineHighlights.refresh",
          "when": "view == gitBaselineHighlights.repositories",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Baseline",
      "properties": {
        "gitBaselineHighlights.repository": {
          "type": "string",
          "default": "",
          "description": "%config.repository%",
          "scope": "resource"
        },
        "gitBaselineHighlights.base": {
          "type": "string",
          "default": "",
          "description": "%config.base%",
          "scope": "resource"
        },
        "gitBaselineHighlights.projectionStart": {
          "type": "string",
          "default": "",
          "description": "%config.projectionStart%",
          "scope": "resource"
        },
        "gitBaselineHighlights.projectionEnd": {
          "type": "string",
          "default": "",
          "description": "%config.projectionEnd%",
          "scope": "resource"
        },
        "gitBaselineHighlights.projectionTarget": {
          "type": "string",
          "default": "",
          "description": "%config.projectionTarget%",
          "scope": "resource"
        },
        "gitBaselineHighlights.comparisonMode": {
          "type": "string",
          "enum": [
            "direct",
            "mergeBase"
          ],
          "enumDescriptions": [
            "%config.comparisonMode.direct%",
            "%config.comparisonMode.mergeBase%"
          ],
          "default": "direct",
          "description": "%config.comparisonMode%",
          "scope": "resource"
        },
        "gitBaselineHighlights.followBase": {
          "type": "boolean",
          "default": false,
          "description": "%config.followBase%",
          "scope": "resource"
        },
        "gitBaselineHighlights.scanDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 8,
          "description": "%config.scanDepth%",
          "scope": "resource"
        },
        "gitBaselineHighlights.showGutterIcons": {
          "type": "boolean",
          "default": false,
          "description": "%config.showGutterIcons%"
        },
        "gitBaselineHighlights.showOverviewRuler": {
          "type": "boolean",
          "default": false,
          "description": "%config.showOverviewRuler%"
        },
        "gitBaselineHighlights.showFileBadges": {
          "type": "boolean",
          "default": false,
          "description": "%config.showFileBadges%"
        }
      }
    },
    "colors": [
      {
        "id": "gitBaselineHighlights.added",
        "description": "Fixed baseline added color",
        "defaults": {
          "dark": "#5AD690",
          "light": "#20834B",
          "highContrast": "#5AD690"
        }
      },
      {
        "id": "gitBaselineHighlights.modified",
        "description": "Fixed baseline modified color",
        "defaults": {
          "dark": "#E6B45C",
          "light": "#AC6600",
          "highContrast": "#E6B45C"
        }
      },
      {
        "id": "gitBaselineHighlights.deleted",
        "description": "Fixed baseline deleted color",
        "defaults": {
          "dark": "#EC7777",
          "light": "#C83030",
          "highContrast": "#EC7777"
        }
      },
      {
        "id": "gitBaselineHighlights.addedBackground",
        "description": "Fixed baseline addedBackground color",
        "defaults": {
          "dark": "#48B87518",
          "light": "#38A06015",
          "highContrast": "#48B87528"
        }
      },
      {
        "id": "gitBaselineHighlights.modifiedBackground",
        "description": "Fixed baseline modifiedBackground color",
        "defaults": {
          "dark": "#D994381A",
          "light": "#D994381A",
          "highContrast": "#D9943828"
        }
      },
      {
        "id": "gitBaselineHighlights.deletedBackground",
        "description": "Fixed baseline deletion anchor background",
        "defaults": {
          "dark": "#EC77771A",
          "light": "#C8303015",
          "highContrast": "#EC777728"
        }
      },
      {
        "id": "gitBaselineHighlights.addedWeakBackground",
        "description": "Subdued projected added background",
        "defaults": {
          "dark": "#48B8750C",
          "light": "#38A0600A",
          "highContrast": "#48B87516"
        }
      },
      {
        "id": "gitBaselineHighlights.modifiedWeakBackground",
        "description": "Subdued projected modified background",
        "defaults": {
          "dark": "#D994380D",
          "light": "#D994380B",
          "highContrast": "#D9943818"
        }
      },
      {
        "id": "gitBaselineHighlights.deletedWeakBackground",
        "description": "Subdued projected deletion background",
        "defaults": {
          "dark": "#EC77770D",
          "light": "#C830300B",
          "highContrast": "#EC777718"
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test core.test.js extension.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies --no-yarn",
    "package:offline": "python3 scripts/package_extension.py",
    "publish": "npx --yes @vscode/vsce publish --no-dependencies --no-yarn",
    "publish:azure": "npx --yes @vscode/vsce publish --no-dependencies --no-yarn --azure-credential"
  },
  "license": "MIT",
  "author": "Hash012",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hash012/git-baseline-highlights.git"
  },
  "homepage": "https://github.com/Hash012/git-baseline-highlights#readme",
  "bugs": {
    "url": "https://github.com/Hash012/git-baseline-highlights/issues"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "baseline",
    "diff",
    "decorations",
    "highlights"
  ]
}
